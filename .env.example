# Core
FRIDAY_ENV=dev
FRIDAY_API_PORT=9001
FRIDAY_WEB_CONCURRENCY=2
FRIDAY_FRONTEND_PORT=5173

# Capabilities (default safe)
FRIDAY_LLM_ENABLED=0
FRIDAY_PROMPT_PROFILE=friday_exec
FRIDAY_MODEL_CLASS=30b
FRIDAY_MODEL_NAME=Lexi
FRIDAY_CODER_ENABLED=0
FRIDAY_CODER_MODEL_NAME=
FRIDAY_STT_ENABLED=0
FRIDAY_TTS_ENABLED=0
FRIDAY_VISION_ENABLED=0
FRIDAY_GESTURE_ENABLED=0
FRIDAY_AVATAR_ENABLED=0
FRIDAY_JOBS_ENABLED=1
FRIDAY_TOOLS_ENABLED=0
FRIDAY_TOOLS_REQUIRE_CONFIRM=1
FRIDAY_DEBUG_TOOL_ERRORS=0
FRIDAY_TRUST_MODE=strict
FRIDAY_TRUST_SAFE_TOOLS=list_facts,search_local_logs
FRIDAY_DEBUG_APIS_ENABLED=0
FRIDAY_DEBUG_PROMPT=0
FRIDAY_DEBUG_PROMPT_MAX_CHARS=2000
FRIDAY_SYSTEM_PROMPT_MAX_CHARS=16000
FRIDAY_AGENT_MAIN_MAX_CONCURRENT=4
FRIDAY_AGENT_SUBAGENT_MAX_CONCURRENT=8
FRIDAY_AGENT_MAX_CONCURRENT=1
FRIDAY_INTERACTION_DEFAULT_MODE=neutral
FRIDAY_INTERACTION_ONE_SCREEN_CHARS=900
FRIDAY_INTERACTION_PLAYFUL_ENABLED=0

# SketchMath (frontend and backend are both explicit, default off)
FRIDAY_SKETCHMATH_ENABLED=0
REACT_APP_SKETCHMATH_ENABLED=0
FRIDAY_SKETCHMATH_DOCUMENT_V1_ENABLED=0
REACT_APP_SKETCHMATH_FEATURE_HISTORY_ENABLED=0
FRIDAY_SKETCHMATH_HOLE_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_HOLE_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_REVOLVE_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_REVOLVE_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_FILLET_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_FILLET_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_CHAMFER_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_CHAMFER_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_PATTERN_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_PATTERN_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_MIRROR_FEATURES_ENABLED=0
REACT_APP_SKETCHMATH_MIRROR_FEATURES_ENABLED=0
FRIDAY_SKETCHMATH_ARTIFACT_JOBS_ENABLED=0
REACT_APP_SKETCHMATH_ARTIFACT_JOBS_ENABLED=0
FRIDAY_SKETCHMATH_SESSION_DIR=artifacts/sketchmath/sessions
FRIDAY_SKETCHMATH_CAD_EXPORT_DIR=artifacts/sketchmath/cad
FRIDAY_SKETCHMATH_ARTIFACT_JOB_DIR=artifacts/sketchmath/jobs
FRIDAY_SKETCHMATH_FREECAD_CMD=
FRIDAY_SKETCHMATH_CAD_TIMEOUT_SECONDS=60

# Memory
FRIDAY_MEMORY_PROVIDER=muninn
FRIDAY_MEMORY_FALLBACK_PROVIDER=legacy
FRIDAY_MEMORY_PERSIST_ENABLED=0
FRIDAY_MEMORY_VECTOR_ENABLED=0
FRIDAY_MEMORY_FACTS_ENABLED=0
FRIDAY_MEMORY_SUMMARIES_ENABLED=0
FRIDAY_MEMORY_CONSOLIDATION_ENABLED=0
FRIDAY_MEMORY_MAX_FACTS=500
FRIDAY_MEMORY_FACTS_RETRIEVAL_LIMIT=10
FRIDAY_MEMORY_SUMMARY_RETRIEVAL_LIMIT=5
FRIDAY_MEMORY_SUMMARY_EVERY_N_TURNS=20
FRIDAY_EMOTION_LITE_ENABLED=1
MUNINN_BASE_URL=http://muninn:8000
MUNINN_NAMESPACE=friday
MUNINN_PROFILE=friday
MUNINN_REQUIRE_API_KEY=0
MUNINN_API_KEY=
MUNINN_READONLY=0
MUNINN_CONNECT_TIMEOUT_SECONDS=2
MUNINN_READ_TIMEOUT_SECONDS=5
MUNINN_HTTP_OVERALL_TIMEOUT_SECONDS=7
MUNINN_HTTP_RETRIES=1
MUNINN_HTTP_RETRY_BACKOFF_SECONDS=0.2
MUNINN_LIST_PENDING_LIMIT=50
FRIDAY_DEBUG_MEMORY=0
FRIDAY_MEMORY_MAX_INJECT_CARDS=8
FRIDAY_MEMORY_MAX_INJECT_BULLETS=3
FRIDAY_MEMORY_MAX_INJECT_CHARS=1800
FRIDAY_MEMORY_MAX_INJECT_TOKENS=450
FRIDAY_MEMORY_MAX_CANDIDATES_PER_TURN=6
FRIDAY_MEMORY_CONFIRM_MAX_IDS=100
FRIDAY_MEMORY_CONFIRM_MAX_ID_LEN=128
FRIDAY_MEMORY_CONFIRM_MAX_NOTE_CHARS=500

# Service URLs (only used if enabled)
# Compose-backed LLM: http://llm:8000
# Host-run backend with host vLLM: http://127.0.0.1:8008
LLM_BASE_URL=http://llm:8000
FRIDAY_CODER_BASE_URL=
FRIDAY_CODER_API_KEY=
STT_BASE_URL=http://stt:8001
TTS_BASE_URL=http://tts:8002
VISION_BASE_URL=http://vision:8003
AVATAR_BASE_URL=http://avatar:8004

# Storage
FRIDAY_DATA_DIR=/data
FRIDAY_LOG_DIR=/logs

# Queue (optional)
FRIDAY_QUEUE_BACKEND=memory   # memory|redis
REDIS_URL=redis://redis:6379/0
