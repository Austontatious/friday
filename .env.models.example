# When you want models, you can flip these on.
FRIDAY_LLM_ENABLED=1
FRIDAY_MODEL_NAME=Lexi
# Optional specialist model route (falls back to FRIDAY main LLM on failure)
# FRIDAY_CODER_ENABLED=1
# FRIDAY_CODER_MODEL_NAME=coder
# FRIDAY_CODER_BASE_URL=http://127.0.0.1:8105/v1
FRIDAY_VISION_ENABLED=1
# FRIDAY_STT_ENABLED=1
# FRIDAY_TTS_ENABLED=1
# FRIDAY_AVATAR_ENABLED=1

# Only needed when starting HF-backed services
# HF_TOKEN=hf_...
