# Model feature toggles (wire now; start later)
FRIDAY_LLM_ENABLED=0
FRIDAY_CODER_ENABLED=0
FRIDAY_VISION_ENABLED=0
FRIDAY_OMNI_ENABLED=0
FRIDAY_STT_ENABLED=0
FRIDAY_TTS_ENABLED=0

# Service URLs (these are the internal compose hostnames)
LLM_BASE_URL=http://llm-core:8000/v1
CODER_BASE_URL=http://llm-coder:8000/v1
VLM_BASE_URL=http://vlm:8000/v1
OMNI_BASE_URL=http://omni:8000/v1
STT_BASE_URL=http://stt:8001
TTS_BASE_URL=http://tts:8002

# Optional GPU counts (leave default)
FRIDAY_LLM_GPU_COUNT=1
FRIDAY_CODER_GPU_COUNT=1
FRIDAY_VLM_GPU_COUNT=1
FRIDAY_OMNI_GPU_COUNT=1

# Hugging Face token (only needed when you actually start model containers)
# HF_TOKEN=hf_...
