{
  "$defs": {
    "FeatureBuildError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "FeatureBuildError",
      "type": "object"
    },
    "FeatureBuildRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureBuildError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "generated_topology": {
          "items": {
            "$ref": "#/$defs/SemanticTopologyReference"
          },
          "title": "Generated Topology",
          "type": "array"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "measurements": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureMeasurements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "output_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Signature"
        },
        "resolved_references": {
          "items": {
            "$ref": "#/$defs/ResolvedTopologyReference"
          },
          "title": "Resolved References",
          "type": "array"
        },
        "status": {
          "enum": [
            "succeeded",
            "suppressed",
            "failed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "order",
        "status",
        "input_hash"
      ],
      "title": "FeatureBuildRecord",
      "type": "object"
    },
    "FeatureMeasurements": {
      "additionalProperties": false,
      "properties": {
        "bounds_mm": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds Mm",
          "type": "array"
        },
        "hole_count": {
          "title": "Hole Count",
          "type": "integer"
        },
        "net_profile_area_mm2": {
          "title": "Net Profile Area Mm2",
          "type": "number"
        },
        "volume_delta_mm3": {
          "title": "Volume Delta Mm3",
          "type": "number"
        }
      },
      "required": [
        "net_profile_area_mm2",
        "volume_delta_mm3",
        "bounds_mm",
        "hole_count"
      ],
      "title": "FeatureMeasurements",
      "type": "object"
    },
    "ResolvedTopologyReference": {
      "additionalProperties": false,
      "properties": {
        "current_signature": {
          "title": "Current Signature",
          "type": "string"
        },
        "expected_signature": {
          "title": "Expected Signature",
          "type": "string"
        },
        "owner_feature_id": {
          "title": "Owner Feature Id",
          "type": "string"
        },
        "recovery_state": {
          "enum": [
            "exact",
            "recovered"
          ],
          "title": "Recovery State",
          "type": "string"
        },
        "requested_reference_id": {
          "title": "Requested Reference Id",
          "type": "string"
        },
        "resolved_reference_id": {
          "title": "Resolved Reference Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "source_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Entity Id"
        },
        "topology_type": {
          "enum": [
            "face",
            "edge"
          ],
          "title": "Topology Type",
          "type": "string"
        }
      },
      "required": [
        "requested_reference_id",
        "resolved_reference_id",
        "owner_feature_id",
        "topology_type",
        "role",
        "recovery_state",
        "expected_signature",
        "current_signature"
      ],
      "title": "ResolvedTopologyReference",
      "type": "object"
    },
    "SemanticTopologyReference": {
      "additionalProperties": false,
      "properties": {
        "geometric_signature": {
          "title": "Geometric Signature",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Measurements",
          "type": "object"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "owner_feature_id": {
          "title": "Owner Feature Id",
          "type": "string"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "source_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Entity Id"
        },
        "topology_type": {
          "enum": [
            "face",
            "edge"
          ],
          "title": "Topology Type",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "owner_feature_id",
        "topology_type",
        "role",
        "ordinal",
        "geometric_signature"
      ],
      "title": "SemanticTopologyReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "input_revision": {
      "title": "Input Revision",
      "type": "integer"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "rebuild_order": {
      "items": {
        "type": "string"
      },
      "title": "Rebuild Order",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/FeatureBuildRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "input_revision",
    "ok",
    "content_hash"
  ],
  "title": "FeatureRebuildReport",
  "type": "object"
}
