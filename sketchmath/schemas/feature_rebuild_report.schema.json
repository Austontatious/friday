{
  "$defs": {
    "FeatureBuildError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "FeatureBuildError",
      "type": "object"
    },
    "FeatureBuildRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureBuildError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "measurements": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeatureMeasurements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "output_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Signature"
        },
        "status": {
          "enum": [
            "succeeded",
            "suppressed",
            "failed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "order",
        "status",
        "input_hash"
      ],
      "title": "FeatureBuildRecord",
      "type": "object"
    },
    "FeatureMeasurements": {
      "additionalProperties": false,
      "properties": {
        "bounds_mm": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds Mm",
          "type": "array"
        },
        "hole_count": {
          "title": "Hole Count",
          "type": "integer"
        },
        "net_profile_area_mm2": {
          "title": "Net Profile Area Mm2",
          "type": "number"
        },
        "volume_delta_mm3": {
          "title": "Volume Delta Mm3",
          "type": "number"
        }
      },
      "required": [
        "net_profile_area_mm2",
        "volume_delta_mm3",
        "bounds_mm",
        "hole_count"
      ],
      "title": "FeatureMeasurements",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "input_revision": {
      "title": "Input Revision",
      "type": "integer"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "rebuild_order": {
      "items": {
        "type": "string"
      },
      "title": "Rebuild Order",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/FeatureBuildRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "input_revision",
    "ok",
    "content_hash"
  ],
  "title": "FeatureRebuildReport",
  "type": "object"
}
